# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Brainstorm research provider (default: anthropic web search via Messages API).
# Set to none/off to force research.status=unavailable on explicit research asks.
# RESEARCH_PROVIDER=anthropic
# RESEARCH_TIMEOUT_SECONDS=30

# Postgres connection string, from your Supabase project:
# Dashboard > Connect > Connection string (URI). Use the "Session pooler"
# string on IPv4-only networks (most home connections). REQUIRED — the
# server refuses to start without it.
# Placeholder only — replace with your real pooler URI locally (never commit .env).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres  # pragma: allowlist secret

# Auth (v2): email/password + magic link + Sign in with Apple via Supabase.
# AUTH_MODE=dev (default) skips JWT verification. AUTH_MODE=real requires
# SUPABASE_JWT_SECRET. /auth/* also needs SUPABASE_URL + SUPABASE_ANON_KEY.
# AUTH_MODE=dev
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Wearables — Terra API (default aggregator for v2)
# TERRA_API_KEY=
# TERRA_DEV_ID=
# TERRA_WEBHOOK_SECRET=

# Mail & Calendar — Google OAuth (read scopes). Fail closed if unset.
# Redirect URI must be exactly …/mail-calendar/oauth/callback (no query).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_MAIL_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/mail-calendar/oauth/callback
# OAUTH_STATE_SECRET=  # long random string for HMAC state
# TOKEN_ENCRYPTION_KEY=  # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
