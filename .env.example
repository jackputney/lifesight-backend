# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Brainstorm research provider (default: anthropic web search via Messages API).
# Set to none/off to force research.status=unavailable on explicit research asks.
# RESEARCH_PROVIDER=anthropic
# RESEARCH_TIMEOUT_SECONDS=30

# Postgres connection string, from your Supabase project:
# Dashboard > Connect > Connection string (URI). Use the "Session pooler"
# string on IPv4-only networks (most home connections). REQUIRED — the
# server refuses to start without it.
# Placeholder only — replace with your real pooler URI locally (never commit .env).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres  # pragma: allowlist secret

# Auth — self-hosted username/password (routers/auth.py).
# AUTH_MODE=dev   (default) local bypass → fixed DEV_FAKE_USER_ID.
# AUTH_MODE=self  verify short-lived access JWTs; requires AUTH_JWT_SECRET.
#
# Staging/production (APP_ENV or ENVIRONMENT in staging|stage|production|prod)
# MUST use AUTH_MODE=self and a non-empty AUTH_JWT_SECRET.
# AUTH_MODE=dev
# AUTH_MODE=self
# AUTH_JWT_SECRET=  # long random string for HS256 access tokens
# APP_ENV=development

# CORS — comma-separated origins. Local unset → *.
# Staging/production: required explicit allowlist (wildcard rejected).
# CORS_ALLOW_ORIGINS=https://your-app.example

# ElevenLabs TTS (server-side only — never put these in the iOS app).
# POST /voice/speech streams audio/mpeg via Flash v2.5 by default.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Wearables — Terra API (default aggregator for v2)
# TERRA_API_KEY=
# TERRA_DEV_ID=
# TERRA_WEBHOOK_SECRET=  # required outside local AUTH_MODE=dev

# Context budget / rolling summaries (chat model assembly; raw history stays in DB)
# CONTEXT_INPUT_TOKEN_BUDGET=24000
# CONTEXT_RECENT_MESSAGE_CAP=20
# CONTEXT_SUMMARY_THRESHOLD=30
# CONTEXT_SUMMARY_TOKEN_BUDGET=1500
# CONTEXT_CHARS_PER_TOKEN=4

# Offline profile seed script only (scripts/seed_user_profile.py) — not an HTTP admin API.
# ADMIN_SEED_TOKEN=
# ALLOW_PROFILE_SEED_IN_PRODUCTION=  # must be 1 to seed in production (discouraged)
